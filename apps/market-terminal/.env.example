# Leave blank to use same-origin REST, or provide a trusted backend origin.
# For Vite development /api is proxied to existing verified ECB history only.
VITE_MARKET_REST_BASE=
# WebSocket is disabled in the UI until the separate stream gateway is securely deployed.
# Example after deployment: wss://stream.your-chartnova-domain/stream
VITE_MARKET_WS_BASE=

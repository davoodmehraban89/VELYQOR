# Canonical PostgreSQL connection. Provider-agnostic by design.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Market data provider credentials. Never commit real keys.
NAVASAN_API_KEY=
ALPHAVANTAGE_API_KEY=

# Application defaults
APP_TIMEZONE=Asia/Tehran
MARKET_DATA_DEFAULT_QUALITY_THRESHOLD=70

# Never commit real credentials. Production secrets belong in the runtime secret store.
